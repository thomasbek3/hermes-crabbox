[Unit]
Description=Refresh dedicated Cloud Workbench Grok OAuth credential
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=cloud-worker
Group=cloud-workbench
WorkingDirectory=/var/lib/cloud-workbench/auth/grok/.grok
ExecStart=/usr/bin/python3 -I -B /opt/cloud-workbench/integrations/omarchy-cloud/credential_refresh.py --auth-dir /var/lib/cloud-workbench/auth/grok/.grok
TimeoutStartSec=75
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cloud-workbench/auth/grok/.grok
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
LimitCORE=0
MemoryMax=128M
TasksMax=16
StandardOutput=journal
StandardError=journal
